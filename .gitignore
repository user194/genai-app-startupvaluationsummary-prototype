# Local .terraform directories (contains provider plugins)
.terraform/

# Terraform lock file (optional: keep if you want to lock provider versions, ignore if not)
# .terraform.lock.hcl

# Local state files (never commit state files!)
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Variables files (might contain sensitive credentials)
*.tfvars
*.tfvars.json

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# virtual environment files
venv/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
